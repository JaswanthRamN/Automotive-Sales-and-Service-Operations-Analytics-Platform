# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL ETL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=automotive_analytics
POSTGRES_USER=automotive_user
POSTGRES_PASSWORD=change_me
POSTGRES_SSLMODE=prefer
ETL_PROCESSED_DIR=./data/processed
ETL_LOG_PATH=./logs/etl.log

# Airflow DAG
AIRFLOW_HOME=./airflow
AIRFLOW_ENV_FILE=./.env
AIRFLOW_DAG_OWNER=analytics-engineering
AIRFLOW_DAG_SCHEDULE=@daily
AIRFLOW_DAG_RETRIES=2
AIRFLOW_RETRY_DELAY_MINUTES=5
AIRFLOW_MAX_RETRY_DELAY_MINUTES=30
AIRFLOW_TASK_TIMEOUT_MINUTES=60
AIRFLOW_QUALITY_TIMEOUT_MINUTES=15
