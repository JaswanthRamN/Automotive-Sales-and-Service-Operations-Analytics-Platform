# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL ETL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=automotive_analytics
POSTGRES_USER=automotive_user
POSTGRES_PASSWORD=change_me
POSTGRES_SSLMODE=prefer
ETL_PROCESSED_DIR=./data/processed
ETL_LOG_PATH=./logs/etl.log

# FastAPI
API_ENV_FILE=./.env
API_DB_POOL_SIZE=5
API_DB_MAX_OVERFLOW=10
API_DB_POOL_TIMEOUT_SECONDS=30
API_DB_CONNECT_TIMEOUT_SECONDS=10

# Airflow DAG
AIRFLOW_HOME=./airflow
AIRFLOW_ENV_FILE=./.env
AIRFLOW_DAG_OWNER=analytics-engineering
AIRFLOW_DAG_SCHEDULE=@daily
AIRFLOW_DAG_RETRIES=2
AIRFLOW_RETRY_DELAY_MINUTES=5
AIRFLOW_MAX_RETRY_DELAY_MINUTES=30
AIRFLOW_TASK_TIMEOUT_MINUTES=60
AIRFLOW_QUALITY_TIMEOUT_MINUTES=15

# Docker Compose: replace all placeholders before startup.
POSTGRES_PUBLISHED_PORT=5432
API_PORT=8000
AIRFLOW_UI_PORT=8080
AIRFLOW_DB_PASSWORD=replace_with_random_hex
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=replace_with_random_password
AIRFLOW_FERNET_KEY=replace_with_fernet_key
AIRFLOW_JWT_SECRET=replace_with_random_hex
