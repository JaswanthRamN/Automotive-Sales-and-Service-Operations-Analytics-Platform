                "    Source = if UseLocalSnapshot then Table.FromRecords(Json.Document(File.Contents(SnapshotFolder & \"/DimVehicle.json\")))",
                "        else Value.NativeQuery(PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]), \"SELECT vehicle_key,vehicle_id,make AS brand,model,model_year,body_type AS vehicle_type,fuel_type,vehicle_condition,color FROM analytics.dim_vehicle\", null, [EnableFolding=true]),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"vehicle_key\", Int64.Type}, {\"vehicle_id\", type text}, {\"brand\", type text}, {\"model\", type text}, {\"model_year\", Int64.Type}, {\"vehicle_type\", type text}, {\"fuel_type\", type text}, {\"vehicle_condition\", type text}, {\"color\", type text}}, \"en-US\")",
