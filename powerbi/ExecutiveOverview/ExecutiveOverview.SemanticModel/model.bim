            "sourceColumn": "customer_type",
            "summarizeBy": "none"
          },
          {
            "name": "city",
            "dataType": "string",
            "sourceColumn": "city",
            "summarizeBy": "none"
          },
          {
            "name": "state",
            "dataType": "string",
            "sourceColumn": "state",
            "summarizeBy": "none"
          },
          {
            "name": "postal_code",
            "dataType": "string",
            "sourceColumn": "postal_code",
            "summarizeBy": "none"
          },
          {
            "name": "customer_since_date",
            "dataType": "dateTime",
            "sourceColumn": "customer_since_date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "effective_from",
            "dataType": "dateTime",
            "sourceColumn": "effective_from",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "effective_to",
            "dataType": "dateTime",
            "sourceColumn": "effective_to",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "is_current",
            "dataType": "boolean",
            "sourceColumn": "is_current",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimCustomer",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = if UseLocalSnapshot then Table.FromRecords(Json.Document(File.Contents(SnapshotFolder & \"/DimCustomer.json\")))",
                "        else Value.NativeQuery(PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]), \"SELECT customer_key,customer_id,customer_type,city,state,postal_code,customer_since_date,effective_from,effective_to,is_current FROM analytics.dim_customer\", null, [EnableFolding=true]),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"customer_key\", Int64.Type}, {\"customer_id\", type text}, {\"customer_type\", type text}, {\"city\", type text}, {\"state\", type text}, {\"postal_code\", type text}, {\"customer_since_date\", type date}, {\"effective_from\", type date}, {\"effective_to\", type date}, {\"is_current\", type logical}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Revenue",
            "expression": "COALESCE(SUM(FactSales[revenue]), 0)",
            "formatString": "#,0.00",
            "isHidden": false
          },
          {
            "name": "Customers",
            "expression": "COALESCE(DISTINCTCOUNTNOBLANK(DimCustomer[customer_id]), 0)",
            "formatString": "#,0",
            "isHidden": false
          },
          {
            "name": "Qualifying Interactions",
            "expression": "VAR SalesInteractions = CALCULATE(DISTINCTCOUNTNOBLANK(FactSales[sale_id]),\n            KEEPFILTERS(FactSales[sale_status] = \"Completed\"))\n        RETURN COALESCE(SalesInteractions, 0) + [Service Orders]",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "Qualifying Customers",
            "expression": "COALESCE(SUMX(VALUES(DimCustomer[customer_id]),\n            IF(NOT ISBLANK(DimCustomer[customer_id]) &&\n               CALCULATE([Qualifying Interactions]) >= 1, 1, 0)), 0)",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "Repeat Customers",
            "expression": "COALESCE(SUMX(VALUES(DimCustomer[customer_id]),\n            IF(NOT ISBLANK(DimCustomer[customer_id]) &&\n               CALCULATE([Qualifying Interactions]) >= 2, 1, 0)), 0)",
            "formatString": "#,0",
            "isHidden": false
          },
          {
            "name": "Repeat Rate",
            "expression": "DIVIDE([Repeat Customers], [Qualifying Customers])",
            "formatString": "0.00%",
            "isHidden": false
          },
          {
            "name": "Customer Lifetime Value",
            "expression": "VAR AsOfDate = MAX(DimDate[full_date])\n        RETURN IF(NOT ISBLANK(AsOfDate),\n            CALCULATE([Revenue] + [Service Revenue],\n                FILTER(ALL(DimDate), DimDate[full_date] <= AsOfDate)))",
            "formatString": "#,0.00",
            "isHidden": false
          },
          {
            "name": "Customers with Sales",
            "expression": "COALESCE(SUMX(VALUES(DimCustomer[customer_id]), IF(CALCULATE(DISTINCTCOUNTNOBLANK(FactSales[sale_id]), KEEPFILTERS(FactSales[sale_status] = \"Completed\")) > 0, 1, 0)), 0)",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "Customers with Service",
            "expression": "COALESCE(SUMX(VALUES(DimCustomer[customer_id]), IF(CALCULATE([Service Orders]) > 0, 1, 0)), 0)",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "Sales + Service Customers",
            "expression": "COALESCE(SUMX(VALUES(DimCustomer[customer_id]), IF(CALCULATE(DISTINCTCOUNTNOBLANK(FactSales[sale_id]), KEEPFILTERS(FactSales[sale_status] = \"Completed\")) > 0 && CALCULATE([Service Orders]) > 0, 1, 0)), 0)",
            "formatString": "#,0"
          },
          {
            "name": "Service Frequency",
            "expression": "DIVIDE([Service Orders], [Customers with Service])",
            "formatString": "#,0.00"
          }
        ]
      },
      {
