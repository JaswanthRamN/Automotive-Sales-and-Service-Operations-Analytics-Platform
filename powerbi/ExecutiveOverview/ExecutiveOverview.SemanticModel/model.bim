                "    Typed = Table.TransformColumnTypes(Source, {{\"dealership_key\", Int64.Type}, {\"dealership_id\", type text}, {\"dealership_name\", type text}, {\"city\", type text}, {\"state\", type text}, {\"region\", type text}, {\"postal_code\", type text}, {\"opened_date\", type date}}, \"en-US\")",
