{
  "name": "ExecutiveOverview",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "annotations": [
      {
        "name": "PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ],
    "expressions": [
      {
        "name": "UseLocalSnapshot",
        "kind": "m",
        "expression": "true"
      },
      {
        "name": "SnapshotFolder",
        "kind": "m",
        "expression": "\"C:/Users/abhig/Downloads/Automotive-Sales-and-Service-Operations-Analytics-Platform/powerbi/ExecutiveOverview/local-data\""
      },
      {
        "name": "Server",
        "kind": "m",
        "expression": "\"localhost:5432\""
      },
      {
        "name": "Database",
        "kind": "m",
        "expression": "\"automotive_analytics\""
      }
    ],
    "tables": [
      {
        "name": "DimDate",
        "columns": [
          {
            "name": "date_key",
            "dataType": "int64",
            "sourceColumn": "date_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "full_date",
            "dataType": "dateTime",
            "sourceColumn": "full_date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "isKey": true
          },
          {
            "name": "calendar_year",
            "dataType": "int64",
            "sourceColumn": "calendar_year",
            "summarizeBy": "none"
          },
          {
            "name": "month_number",
            "dataType": "int64",
            "sourceColumn": "month_number",
            "summarizeBy": "none"
          },
          {
            "name": "month_name",
            "dataType": "string",
            "sourceColumn": "month_name",
            "summarizeBy": "none"
          },
          {
            "name": "year_month",
            "dataType": "string",
            "sourceColumn": "year_month",
            "summarizeBy": "none",
            "sortByColumn": "year_month_sort"
          },
          {
            "name": "year_month_sort",
            "dataType": "int64",
            "sourceColumn": "year_month_sort",
            "summarizeBy": "none"
          },
          {
            "name": "quarter_number",
            "dataType": "int64",
            "sourceColumn": "quarter_number",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimDate",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = if UseLocalSnapshot then Table.FromRecords(Json.Document(File.Contents(SnapshotFolder & \"/DimDate.json\")))",
                "        else Value.NativeQuery(PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]), \"WITH bounds AS (\n SELECT date_trunc('year',min(d))::date lo,\n (date_trunc('year',max(d))+interval '1 year - 1 day')::date hi\n FROM (SELECT full_date d FROM analytics.dim_date\n UNION ALL SELECT promised_at::date FROM analytics.fact_service) events\n), calendar AS (SELECT generate_series(lo,hi,interval '1 day')::date full_date FROM bounds)\nSELECT to_char(full_date,'YYYYMMDD')::integer date_key, full_date,\n extract(year FROM full_date)::integer calendar_year,\n extract(month FROM full_date)::integer month_number,\n to_char(full_date,'Month') month_name, to_char(full_date,'YYYY-MM') year_month,\n to_char(full_date,'YYYYMM')::integer year_month_sort,\n extract(quarter FROM full_date)::integer quarter_number FROM calendar\", null, [EnableFolding=true]),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"date_key\", Int64.Type}, {\"full_date\", type date}, {\"calendar_year\", Int64.Type}, {\"month_number\", Int64.Type}, {\"month_name\", type text}, {\"year_month\", type text}, {\"year_month_sort\", Int64.Type}, {\"quarter_number\", Int64.Type}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "dataCategory": "Time"
      },
      {
        "name": "DimSnapshotDate",
        "columns": [
          {
            "name": "date_key",
            "dataType": "int64",
            "sourceColumn": "date_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "full_date",
            "dataType": "dateTime",
            "sourceColumn": "full_date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "isKey": true
          },
          {
            "name": "calendar_year",
            "dataType": "int64",
            "sourceColumn": "calendar_year",
            "summarizeBy": "none"
          },
          {
            "name": "month_number",
            "dataType": "int64",
            "sourceColumn": "month_number",
            "summarizeBy": "none"
          },
          {
            "name": "month_name",
            "dataType": "string",
            "sourceColumn": "month_name",
            "summarizeBy": "none"
          },
          {
            "name": "year_month",
            "dataType": "string",
            "sourceColumn": "year_month",
            "summarizeBy": "none",
            "sortByColumn": "year_month_sort"
          },
          {
            "name": "year_month_sort",
            "dataType": "int64",
            "sourceColumn": "year_month_sort",
            "summarizeBy": "none"
          },
          {
            "name": "quarter_number",
            "dataType": "int64",
            "sourceColumn": "quarter_number",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimSnapshotDate",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = if UseLocalSnapshot then Table.FromRecords(Json.Document(File.Contents(SnapshotFolder & \"/DimSnapshotDate.json\")))",
                "        else Value.NativeQuery(PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]), \"WITH bounds AS (\n SELECT date_trunc('year',min(d))::date lo,\n (date_trunc('year',max(d))+interval '1 year - 1 day')::date hi\n FROM (SELECT full_date d FROM analytics.dim_date\n UNION ALL SELECT promised_at::date FROM analytics.fact_service) events\n), calendar AS (SELECT generate_series(lo,hi,interval '1 day')::date full_date FROM bounds)\nSELECT to_char(full_date,'YYYYMMDD')::integer date_key, full_date,\n extract(year FROM full_date)::integer calendar_year,\n extract(month FROM full_date)::integer month_number,\n to_char(full_date,'Month') month_name, to_char(full_date,'YYYY-MM') year_month,\n to_char(full_date,'YYYYMM')::integer year_month_sort,\n extract(quarter FROM full_date)::integer quarter_number FROM calendar\", null, [EnableFolding=true]),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"date_key\", Int64.Type}, {\"full_date\", type date}, {\"calendar_year\", Int64.Type}, {\"month_number\", Int64.Type}, {\"month_name\", type text}, {\"year_month\", type text}, {\"year_month_sort\", Int64.Type}, {\"quarter_number\", Int64.Type}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "dataCategory": "Time"
      },
      {
        "name": "DimCustomer",
        "columns": [
          {
            "name": "customer_key",
            "dataType": "int64",
            "sourceColumn": "customer_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "customer_id",
            "dataType": "string",
            "sourceColumn": "customer_id",
            "summarizeBy": "none"
          },
          {
            "name": "customer_type",
