            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "FactService",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = if UseLocalSnapshot then Table.FromRecords(Json.Document(File.Contents(SnapshotFolder & \"/FactService.json\")))",
                "        else Value.NativeQuery(PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]), \"SELECT a.appointment_id,a.appointment_date_key,a.customer_key,a.vehicle_key,\n a.dealership_key,a.service_advisor_key,a.technician_key,a.service_key,a.service_order_id,\n a.appointment_status,a.appointment_count,a.completed_appointment_count,a.cancellation_count,\n a.no_show_count,a.completion_eligible_count,a.repair_order_quantity,a.payer_type,\n a.opened_at,a.promised_at,a.completed_at,\n to_char(a.opened_at::date,'YYYYMMDD')::integer opened_date_key,\n to_char(a.promised_at::date,'YYYYMMDD')::integer promised_date_key,\n to_char(a.completed_at::date,'YYYYMMDD')::integer completed_date_key,\n a.completed_on_time,a.turnaround_hours,a.labor_revenue,a.parts_revenue,a.discount_amount,\n a.service_revenue,a.service_cost,a.service_profit,a.service_cost_available,ro.order_status\n FROM analytics.vw_service_appointment_detail a\n LEFT JOIN analytics.fact_service ro ON ro.service_fact_key=a.service_fact_key\", null, [EnableFolding=true]),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"appointment_id\", type text}, {\"appointment_date_key\", Int64.Type}, {\"customer_key\", Int64.Type}, {\"vehicle_key\", Int64.Type}, {\"dealership_key\", Int64.Type}, {\"service_advisor_key\", Int64.Type}, {\"technician_key\", Int64.Type}, {\"service_key\", Int64.Type}, {\"service_order_id\", type text}, {\"appointment_status\", type text}, {\"appointment_count\", Int64.Type}, {\"completed_appointment_count\", Int64.Type}, {\"cancellation_count\", Int64.Type}, {\"no_show_count\", Int64.Type}, {\"completion_eligible_count\", Int64.Type}, {\"repair_order_quantity\", Int64.Type}, {\"payer_type\", type text}, {\"opened_at\", type datetime}, {\"promised_at\", type datetime}, {\"completed_at\", type datetime}, {\"opened_date_key\", Int64.Type}, {\"promised_date_key\", Int64.Type}, {\"completed_date_key\", Int64.Type}, {\"completed_on_time\", type logical}, {\"turnaround_hours\", Currency.Type}, {\"labor_revenue\", Currency.Type}, {\"parts_revenue\", Currency.Type}, {\"discount_amount\", Currency.Type}, {\"service_revenue\", Currency.Type}, {\"service_cost\", type text}, {\"service_profit\", type text}, {\"service_cost_available\", type logical}, {\"order_status\", type text}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Service Revenue",
            "expression": "COALESCE(CALCULATE(SUM(FactService[service_revenue]),\n            USERELATIONSHIP(DimDate[date_key], FactService[completed_date_key]),\n            KEEPFILTERS(FactService[order_status] = \"Completed\")), 0)",
            "formatString": "#,0.00",
            "isHidden": false
          },
          {
            "name": "Service Orders",
            "expression": "COALESCE(CALCULATE(DISTINCTCOUNTNOBLANK(FactService[service_order_id]),\n            USERELATIONSHIP(DimDate[date_key], FactService[completed_date_key]),\n            KEEPFILTERS(FactService[order_status] = \"Completed\")), 0)",
            "formatString": "#,0",
            "isHidden": false
          },
          {
            "name": "Average Repair Order",
            "expression": "DIVIDE([Service Revenue], [Service Orders])",
            "formatString": "#,0.00",
            "isHidden": false
          },
          {
            "name": "Completion Rate",
            "expression": "DIVIDE(SUM(FactService[completed_appointment_count]),\n               SUM(FactService[completion_eligible_count]))",
            "formatString": "0.00%",
            "isHidden": false
          }
        ]
      },
