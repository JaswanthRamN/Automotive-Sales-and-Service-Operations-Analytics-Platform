          }
        ],
        "partitions": [
          {
            "name": "FactSales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = if UseLocalSnapshot then Table.FromRecords(Json.Document(File.Contents(SnapshotFolder & \"/FactSales.json\")))",
                "        else Value.NativeQuery(PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]), \"SELECT sales_key,sale_id,sale_date_key,customer_key,vehicle_key,dealership_key,salesperson_key,sales_channel,payment_type,sale_status,units_sold,list_price,discount_amount,revenue,vehicle_cost,gross_profit FROM analytics.vw_sales_detail\", null, [EnableFolding=true]),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"sales_key\", Int64.Type}, {\"sale_id\", type text}, {\"sale_date_key\", Int64.Type}, {\"customer_key\", Int64.Type}, {\"vehicle_key\", Int64.Type}, {\"dealership_key\", Int64.Type}, {\"salesperson_key\", Int64.Type}, {\"sales_channel\", type text}, {\"payment_type\", type text}, {\"sale_status\", type text}, {\"units_sold\", Int64.Type}, {\"list_price\", Currency.Type}, {\"discount_amount\", Currency.Type}, {\"revenue\", Currency.Type}, {\"vehicle_cost\", Currency.Type}, {\"gross_profit\", Currency.Type}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Units Sold",
            "expression": "COALESCE(SUM(FactSales[units_sold]), 0)",
            "formatString": "#,0",
            "isHidden": false
          },
          {
            "name": "ASP",
            "expression": "DIVIDE([Revenue], [Units Sold])",
            "formatString": "#,0.00",
            "isHidden": false
          },
          {
            "name": "Gross Profit",
            "expression": "COALESCE(SUM(FactSales[gross_profit]), 0)",
            "formatString": "#,0.00",
            "isHidden": false
          },
          {
            "name": "Gross Margin %",
            "expression": "DIVIDE([Gross Profit], [Revenue])",
            "formatString": "0.00%",
            "isHidden": false
          }
        ]
      },
      {
        "name": "FactInventory",
        "columns": [
          {
            "name": "inventory_key",
            "dataType": "int64",
