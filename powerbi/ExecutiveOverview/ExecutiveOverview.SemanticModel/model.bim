            "isHidden": true
          },
          {
            "name": "days_in_inventory",
            "dataType": "int64",
            "sourceColumn": "days_in_inventory",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "aging_bucket",
            "dataType": "string",
            "sourceColumn": "aging_bucket",
            "summarizeBy": "none",
            "isHidden": false,
            "sortByColumn": "aging_bucket_sort"
          },
          {
            "name": "aging_bucket_sort",
            "dataType": "int64",
