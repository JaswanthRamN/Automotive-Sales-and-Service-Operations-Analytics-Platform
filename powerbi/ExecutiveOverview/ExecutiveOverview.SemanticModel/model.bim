          },
          {
            "name": "is_slow_moving",
            "dataType": "boolean",
            "sourceColumn": "is_slow_moving",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "FactInventory",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = if UseLocalSnapshot then Table.FromRecords(Json.Document(File.Contents(SnapshotFolder & \"/FactInventory.json\")))",
                "        else Value.NativeQuery(PostgreSQL.Database(Server, Database, [CreateNavigationProperties=false]), \"SELECT inventory_key,inventory_id,snapshot_date_key,vehicle_key,dealership_key,acquired_date,to_char(acquired_date,'YYYYMMDD')::integer acquired_date_key,inventory_status,inventory_units,inventory_value,days_in_inventory,aging_bucket,aging_bucket_sort,is_slow_moving FROM analytics.vw_inventory_detail\", null, [EnableFolding=true]),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"inventory_key\", Int64.Type}, {\"inventory_id\", type text}, {\"snapshot_date_key\", Int64.Type}, {\"vehicle_key\", Int64.Type}, {\"dealership_key\", Int64.Type}, {\"acquired_date\", type date}, {\"acquired_date_key\", Int64.Type}, {\"inventory_status\", type text}, {\"inventory_units\", Int64.Type}, {\"inventory_value\", Currency.Type}, {\"days_in_inventory\", Int64.Type}, {\"aging_bucket\", type text}, {\"aging_bucket_sort\", Int64.Type}, {\"is_slow_moving\", type logical}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Inventory Snapshot Key",
            "expression": "VAR AsOfDate = MAX(DimSnapshotDate[full_date])\n        VAR AsOfKey = YEAR(AsOfDate) * 10000 + MONTH(AsOfDate) * 100 + DAY(AsOfDate)\n        RETURN IF(NOT ISBLANK(AsOfDate),\n            CALCULATE(MAX(FactInventory[snapshot_date_key]), REMOVEFILTERS(),\n                FactInventory[snapshot_date_key] <= AsOfKey))",
            "formatString": "#,0",
            "isHidden": true
          },
          {
            "name": "Inventory Units",
            "expression": "VAR SnapshotKey = [Inventory Snapshot Key]\n        RETURN IF(ISBLANK(SnapshotKey), BLANK(),\n            COALESCE(CALCULATE(SUM(FactInventory[inventory_units]),\n                REMOVEFILTERS(DimSnapshotDate),\n                TREATAS({SnapshotKey}, FactInventory[snapshot_date_key])), 0))",
            "formatString": "#,0",
            "isHidden": false
          },
          {
            "name": "Inventory Value",
            "expression": "VAR SnapshotKey = [Inventory Snapshot Key]\n        RETURN IF(ISBLANK(SnapshotKey), BLANK(),\n            COALESCE(CALCULATE(SUM(FactInventory[inventory_value]),\n                REMOVEFILTERS(DimSnapshotDate),\n                TREATAS({SnapshotKey}, FactInventory[snapshot_date_key])), 0))",
            "formatString": "#,0.00",
            "isHidden": false
          },
          {
            "name": "Average Days in Inventory",
            "expression": "VAR SnapshotKey = [Inventory Snapshot Key]\n        VAR WeightedDays = CALCULATE(\n            SUMX(FactInventory, FactInventory[days_in_inventory] * FactInventory[inventory_units]),\n            REMOVEFILTERS(DimSnapshotDate),\n            TREATAS({SnapshotKey}, FactInventory[snapshot_date_key]))\n        RETURN IF(NOT ISBLANK(SnapshotKey), DIVIDE(WeightedDays, [Inventory Units]))",
            "formatString": "#,0.00",
            "isHidden": false
          },
          {
            "name": "Slow-Moving Vehicles",
            "expression": "VAR SnapshotKey = [Inventory Snapshot Key]\n        RETURN IF(ISBLANK(SnapshotKey), BLANK(),\n            COALESCE(CALCULATE(DISTINCTCOUNTNOBLANK(FactInventory[vehicle_key]),\n                REMOVEFILTERS(DimSnapshotDate),\n                TREATAS({SnapshotKey}, FactInventory[snapshot_date_key]),\n                KEEPFILTERS(FactInventory[days_in_inventory] > 90),\n                KEEPFILTERS(FactInventory[inventory_units] > 0)), 0))",
            "formatString": "#,0",
            "isHidden": false
          },
          {
            "name": "Executive Inventory Value",
            "expression": "VAR AsOfDate = MAX(DimDate[full_date]) RETURN IF(NOT ISBLANK(AsOfDate), CALCULATE([Inventory Value], REMOVEFILTERS(DimSnapshotDate), TREATAS({AsOfDate}, DimSnapshotDate[full_date])))",
            "formatString": "#,0.00"
          },
          {
            "name": "Executive Inventory Units",
            "expression": "VAR AsOfDate = MAX(DimDate[full_date]) RETURN IF(NOT ISBLANK(AsOfDate), CALCULATE([Inventory Units], REMOVEFILTERS(DimSnapshotDate), TREATAS({AsOfDate}, DimSnapshotDate[full_date])))",
            "formatString": "#,0"
          },
          {
            "name": "Executive Snapshot Date",
            "expression": "VAR AsOfDate = MAX(DimDate[full_date]) VAR SnapshotKey = CALCULATE([Inventory Snapshot Key], REMOVEFILTERS(DimSnapshotDate), TREATAS({AsOfDate}, DimSnapshotDate[full_date])) RETURN IF(NOT ISBLANK(AsOfDate) && NOT ISBLANK(SnapshotKey), DATE(INT(SnapshotKey / 10000), INT(MOD(SnapshotKey, 10000) / 100), MOD(SnapshotKey, 100)))",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "As-Of Inventory Value",
            "expression": "VAR AsOfDate = MAX(DimDate[full_date]) RETURN IF(NOT ISBLANK(AsOfDate), CALCULATE([Inventory Value], REMOVEFILTERS(DimSnapshotDate), TREATAS({AsOfDate}, DimSnapshotDate[full_date])))",
            "formatString": "#,0.00"
          },
          {
            "name": "As-Of Inventory Units",
            "expression": "VAR AsOfDate = MAX(DimDate[full_date]) RETURN IF(NOT ISBLANK(AsOfDate), CALCULATE([Inventory Units], REMOVEFILTERS(DimSnapshotDate), TREATAS({AsOfDate}, DimSnapshotDate[full_date])))",
            "formatString": "#,0"
          },
          {
            "name": "As-Of Average Days in Inventory",
            "expression": "VAR AsOfDate = MAX(DimDate[full_date]) RETURN IF(NOT ISBLANK(AsOfDate), CALCULATE([Average Days in Inventory], REMOVEFILTERS(DimSnapshotDate), TREATAS({AsOfDate}, DimSnapshotDate[full_date])))",
            "formatString": "#,0.00"
          },
          {
            "name": "As-Of Slow-Moving Vehicles",
            "expression": "VAR AsOfDate = MAX(DimDate[full_date]) RETURN IF(NOT ISBLANK(AsOfDate), CALCULATE([Slow-Moving Vehicles], REMOVEFILTERS(DimSnapshotDate), TREATAS({AsOfDate}, DimSnapshotDate[full_date])))",
            "formatString": "#,0"
          },
          {
            "name": "As-Of Snapshot Date",
            "expression": "VAR AsOfDate = MAX(DimDate[full_date]) VAR SnapshotKey = CALCULATE([Inventory Snapshot Key], REMOVEFILTERS(DimSnapshotDate), TREATAS({AsOfDate}, DimSnapshotDate[full_date])) RETURN IF(NOT ISBLANK(AsOfDate) && NOT ISBLANK(SnapshotKey), DATE(INT(SnapshotKey / 10000), INT(MOD(SnapshotKey, 10000) / 100), MOD(SnapshotKey, 100)))",
            "formatString": "yyyy-MM-dd"
          }
        ]
      },
