            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "yyyy-MM-dd",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "acquired_date_key",
            "dataType": "int64",
            "sourceColumn": "acquired_date_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "inventory_status",
            "dataType": "string",
            "sourceColumn": "inventory_status",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "inventory_units",
            "dataType": "int64",
            "sourceColumn": "inventory_units",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
